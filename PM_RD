<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>项目协作交付观测台 v5.0 (审计留痕版)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        .role-A { border-bottom: 3px solid #6366f1; }
        .role-B { border-bottom: 3px solid #f59e0b; }
        .role-C { border-bottom: 3px solid #10b981; }
        .role-D { border-bottom: 3px solid #f43f5e; }
        input:disabled { cursor: not-allowed; opacity: 0.5; background: #f8fafc; }
        #loginOverlay { backdrop-filter: blur(12px); }
        .log-item { animation: fadeIn 0.3s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="bg-slate-50 min-h-screen p-4 md:p-8 text-slate-700">

    <div id="loginOverlay" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center transition-all">
        <div class="bg-white p-8 rounded-3xl shadow-2xl max-w-sm w-full mx-4 text-center border border-white/20">
            <h2 class="text-2xl font-bold mb-2">三陶教育项目审计系统</h2>
            <p class="text-slate-400 text-sm mb-6">请输入口令验证身份</p>
            <input type="password" id="rolePassword" placeholder="请输入口令..." class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 mb-4 focus:border-indigo-500 outline-none text-center text-xl tracking-widest">
            <button onclick="verifyIdentity()" class="w-full bg-slate-900 text-white py-3 rounded-xl font-bold hover:bg-black transition active:scale-95">进入系统</button>
        </div>
    </div>

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-8 bg-white p-6 rounded-3xl shadow-sm border border-slate-100 gap-4">
            <div>
                <h1 class="text-3xl font-black text-slate-800 tracking-tighter italic">SANTAO PROJECT <span class="text-indigo-600">v5.0</span></h1>
                <div class="flex gap-3 mt-3">
                    <span id="badgeA" class="opacity-20 px-2 py-1 bg-indigo-50 text-indigo-600 rounded text-[10px] font-bold">A:发起</span>
                    <span id="badgeB" class="opacity-20 px-2 py-1 bg-amber-50 text-amber-600 rounded text-[10px] font-bold">B:预计</span>
                    <span id="badgeC" class="opacity-20 px-2 py-1 bg-emerald-50 text-emerald-600 rounded text-[10px] font-bold">C:确认</span>
                    <span id="badgeD" class="opacity-20 px-2 py-1 bg-rose-50 text-rose-600 rounded text-[10px] font-bold">D:管理</span>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-[10px] text-slate-400 font-bold uppercase">Current Operator</p>
                    <p id="currentIdentityText" class="font-black text-slate-900 text-lg">GUEST</p>
                </div>
                <button onclick="addNewTask()" id="addBtn" disabled class="bg-slate-300 text-white h-12 px-8 rounded-xl font-bold shadow-lg transition duration-200">+ 新增</button>
                <button onclick="logout()" class="text-slate-300 hover:text-red-500 transition">退出</button>
            </div>
        </div>

        <div class="bg-white shadow-xl shadow-slate-200/50 rounded-3xl overflow-hidden border border-slate-200 mb-8">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-50/50 border-b border-slate-100 text-slate-400 text-[10px] font-black uppercase tracking-widest">
                        <tr>
                            <th class="p-6 w-64">任务名称 (A/D)</th>
                            <th class="p-6">期待交付 (A/D)</th>
                            <th class="p-6 text-amber-600">预计交付 (B/D)</th>
                            <th class="p-6 text-indigo-600">确定交付 (C/D)</th>
                            <th class="p-6 text-emerald-600">完成交付 (C/D)</th>
                            <th class="p-6 text-center">状态</th>
                            <th class="p-6 text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody id="taskTableBody" class="divide-y divide-slate-50 text-sm"></tbody>
                </table>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="md:col-span-2 bg-white p-6 rounded-3xl border border-slate-200">
                <h3 class="font-black text-slate-800 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    全过程行为痕迹
                </h3>
                <div id="logList" class="space-y-3 max-h-[400px] overflow-y-auto pr-2"></div>
            </div>
            
            <div class="bg-slate-900 p-6 rounded-3xl text-white">
                <h3 class="font-bold text-slate-400 mb-4 text-xs uppercase tracking-widest">删除记录 (仅保留3条)</h3>
                <div id="deleteLogList" class="space-y-4"></div>
            </div>
        </div>
    </div>

    <script>
        const SUPABASE_URL = 'https://yowpkllrpoacfawupiyc.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_s4uj9ALifFXAKcHYC0TYHQ_7cxFHErG'; //

        // 🔐 角色口令配置
        const PASSWORDS = { 'A': '5231', 'B': '1760', 'C': '4382', 'D': '9999' }; 

        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        let currentTasks = [];
        let myRole = null;

        function verifyIdentity() {
            const input = document.getElementById('rolePassword').value;
            const role = Object.keys(PASSWORDS).find(key => PASSWORDS[key] === input);
            if (role) {
                myRole = role;
                localStorage.setItem('project_role', role);
                initSystem();
            } else { alert("口令错误"); }
        }

        function initSystem() {
            document.getElementById('loginOverlay').classList.add('hidden');
            document.getElementById('currentIdentityText').innerText = `ROLE ${myRole}`;
            const addBtn = document.getElementById('addBtn');
            if (['A', 'C', 'D'].includes(myRole)) {
                addBtn.disabled = false;
                addBtn.classList.replace('bg-slate-300', 'bg-slate-900');
            }
            document.getElementById(`badge${myRole}`).classList.replace('opacity-20', 'ring-1');
            loadData();
            loadLogs();
        }

        async function loadData() {
            const { data } = await supabaseClient.from('task_platform').select('*').order('created_at', { ascending: false });
            if (data) { currentTasks = data; renderTable(); }
        }

        function renderTable() {
            const tbody = document.getElementById('taskTableBody');
            tbody.innerHTML = currentTasks.map(task => {
                const canEdit = (role) => (myRole === role || myRole === 'D');
                return `
                <tr class="group">
                    <td class="p-5"><input type="text" value="${task.task_name || ''}" class="${canEdit('A') ? 'role-A font-bold' : ''}" ${!canEdit('A') ? 'disabled' : ''} onblur="updateData('${task.id}', 'task_name', this.value)"></td>
                    <td class="p-5"><input type="date" value="${task.date_expect || ''}" class="${canEdit('A') ? 'role-A' : ''}" ${!canEdit('A') ? 'disabled' : ''} onchange="updateData('${task.id}', 'date_expect', this.value)"></td>
                    <td class="p-5"><input type="date" value="${task.date_estimate || ''}" class="${canEdit('B') ? 'role-B' : ''}" ${!canEdit('B') ? 'disabled' : ''} onchange="updateData('${task.id}', 'date_estimate', this.value)"></td>
                    <td class="p-5"><input type="date" value="${task.date_confirmed || ''}" class="${canEdit('C') ? 'role-C' : ''}" ${!canEdit('C') ? 'disabled' : ''} onchange="updateData('${task.id}', 'date_confirmed', this.value)"></td>
                    <td class="p-5"><input type="date" value="${task.date_final || ''}" class="${canEdit('C') ? 'role-C' : ''}" ${!canEdit('C') ? 'disabled' : ''} onchange="updateData('${task.id}', 'date_final', this.value)"></td>
                    <td class="p-5 text-center">
                        <select onchange="updateData('${task.id}', 'status', this.value)" ${!canEdit('C') ? 'disabled' : ''} class="text-[10px] font-bold border-none rounded-full px-3 py-1 ${task.status === '已完成' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700'}">
                            <option ${task.status === '进行中' ? 'selected' : ''}>进行中</option>
                            <option ${task.status === '已完成' ? 'selected' : ''}>已完成</option>
                        </select>
                    </td>
                    <td class="p-5 text-center">${myRole === 'D' ? `<button onclick="deleteTask('${task.id}', '${task.task_name}')" class="text-slate-300 hover:text-red-500">删除</button>` : '🔒'}</td>
                </tr>`;
            }).join('');
        }

        async function updateData(id, field, value) {
            const task = currentTasks.find(t => t.id === id);
            const { error } = await supabaseClient.from('task_platform').update({ [field]: value }).eq('id', id);
            if (!error && myRole) {
                await supabaseClient.from('activity_logs').insert([{
                    task_id: id,
                    task_name: task.task_name,
                    operator_role: myRole,
                    action_type: '修改',
                    change_detail: `将 [${field}] 更新为: ${value}`
                }]);
            }
        }

        // [核心删除逻辑]：删除项目 + 记录日志 + 动态维护3条
        async function deleteTask(id, name) {
            if (!confirm(`确定要删除项目【${name}】吗？此操作将留下痕迹。`)) return;

            // 1. 执行删除项目
            await supabaseClient.from('task_platform').delete().eq('id', id);

            // 2. 写入删除日志
            await supabaseClient.from('activity_logs').insert([{
                task_name: name,
                operator_role: myRole,
                action_type: '删除项目',
                change_detail: `彻底删除了该项目及其关联数据`
            }]);

            // 3. 动态清理：只保留最新的 3 条“删除项目”类型的日志
            const { data: delLogs } = await supabaseClient.from('activity_logs')
                .select('id').eq('action_type', '删除项目').order('created_at', { ascending: false });
            
            if (delLogs && delLogs.length > 3) {
                const idsToDelete = delLogs.slice(3).map(l => l.id);
                await supabaseClient.from('activity_logs').delete().in('id', idsToDelete);
            }
            loadLogs();
        }

        async function loadLogs() {
            const { data } = await supabaseClient.from('activity_logs').select('*').order('created_at', { ascending: false });
            if (data) {
                const modLogs = data.filter(l => l.action_type === '修改');
                const delLogs = data.filter(l => l.action_type === '删除项目');

                document.getElementById('logList').innerHTML = modLogs.map(l => `
                    <div class="log-item p-3 bg-slate-50 rounded-xl border border-slate-100 flex justify-between items-center text-xs">
                        <div><span class="font-bold text-slate-900">${l.task_name}</span> <span class="text-slate-400 mx-2">→</span> ${l.change_detail}</div>
                        <div class="text-[9px] text-slate-300 flex items-center gap-2 font-mono">
                            <span class="bg-indigo-100 text-indigo-500 px-1 rounded uppercase">Role ${l.operator_role}</span>
                            ${new Date(l.created_at).toLocaleTimeString()}
                        </div>
                    </div>`).join('');

                document.getElementById('deleteLogList').innerHTML = delLogs.map(l => `
                    <div class="border-l-2 border-red-500 pl-4 py-1">
                        <p class="text-xs font-bold text-white">${l.task_name}</p>
                        <p class="text-[10px] text-red-400">已被 角色${l.operator_role} 移除</p>
                        <p class="text-[9px] text-slate-500 mt-1">${new Date(l.created_at).toLocaleString()}</p>
                    </div>`).join('');
            }
        }

        async function addNewTask() { await supabaseClient.from('task_platform').insert([{ task_name: '新项目' }]); }
        function logout() { localStorage.removeItem('project_role'); location.reload(); }
        const savedRole = localStorage.getItem('project_role');
        if (savedRole) { myRole = savedRole; initSystem(); }

        supabaseClient.channel('realtime').on('postgres_changes', { event: '*', schema: 'public', table: '*' }, () => { loadData(); loadLogs(); }).subscribe();
    </script>
</body>
</html>
